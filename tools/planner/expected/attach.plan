15e5cc7b83950f1a 11c1ac49bc671b42 INSERT INTO aux1.t VALUES(2, 'two'); SELECT * FROM aux1.t
c094c2fdaf03bd9d da1193e6e56ecb59 INSERT INTO aux1.u(y, z) SELECT b, a FROM main.t WHERE a < 4; SELECT count(*) FROM aux1.u
b5b4d79d7642d316 c09c601c516d91a4 UPDATE aux1.u SET z = -z WHERE x < 3; SELECT x, z FROM aux1.u WHERE x < 4
55372f683e8cc546 38258e9a3c1167c8 DELETE FROM aux1.u WHERE y = 'v1'; SELECT count(*) FROM aux1.u
787f198230d279a6 e3b0c44298fc1c14 INSERT INTO aux2.w VALUES('v9', 9); SELECT * FROM aux2.log
06c7994454300cc9 ae17f8ed3768ce9d INSERT INTO aux2.w VALUES('v1', 0) ON CONFLICT(k) DO UPDATE SET v = v + 10; SELECT * FROM aux2.w
10aa4518eae37200 994d10de86e80a1b BEGIN; UPDATE t SET c = 0; UPDATE aux1.u SET z = 0; UPDATE aux2.w SET v = 0; COMMIT; SELECT sum(c) FROM t
89a5da056dea8bf9 2e7af4bbdaaaacb3 BEGIN; UPDATE t SET c = 0; UPDATE aux1.u SET z = 0; ROLLBACK; SELECT sum(c) FROM t
57e39c94c683854b 17d0824a9bde8b05 CREATE TABLE aux1.n AS SELECT a, b FROM t WHERE a < 3; SELECT * FROM aux1.n
5f82bdb2a2375969 fb04dcb6970e4c3d CREATE INDEX aux2.wv ON w(v); SELECT k FROM aux2.w WHERE v = 2
977cd0dd77d0bb27 501395a7ad5a1b99 DROP TABLE aux1.t; SELECT * FROM t WHERE a = 1
843b48a910d94494 8d8aa3e1a3e50bde ALTER TABLE aux2.w RENAME TO w2; SELECT sql FROM aux2.sqlite_schema ORDER BY name
68cae2b9383b8483 e97e7a9905bfe547 CREATE VIEW aux1.v2 AS SELECT * FROM main.t
c260fa99150e2ba4 10d23b0ac9cddb06 CREATE VIEW aux1.v3 AS SELECT * FROM aux2.w
bd0d6f5143a57d01 bd0d6f5143a57d01 CREATE TRIGGER aux1.tr AFTER INSERT ON u BEGIN INSERT INTO main.t VALUES(new.x, new.y, 0); END
46d5a9e5c153ba60 e3b0c44298fc1c14 CREATE TEMP TRIGGER ttr AFTER INSERT ON aux1.t BEGIN INSERT INTO aux2.log VALUES('t ' || new.b); END; INSERT INTO aux1.t VALUES(5, 'five'); SELECT * FROM aux2.log
aa6c90dc29454a5e 559a20065a44e8c3 CREATE TEMP VIEW tv AS SELECT t.a, u.z FROM t JOIN aux1.u ON u.x = t.a; SELECT * FROM tv WHERE a = 7
