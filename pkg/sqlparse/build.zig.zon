.{
    // What the dialects' SQL parsers share: the module `sqlparse`. The
    // root package (../../build.zig.zon) depends on it by path.
    .name = .sqlparse,
    .version = "0.0.0",
    .fingerprint = 0x66232ed119159f2b, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .sqllex = .{ .path = "../sqllex" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
