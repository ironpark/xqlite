pg_get_viewdef
 SELECT x,
    sqrt(x) AS s,
    exp(x) AS e,
    ln(x) AS l,
    log(x) AS lg,
    log((2)::numeric, x) AS l2,
    power(x, (2)::numeric) AS p,
    power(2.5, x) AS q
   FROM g;
