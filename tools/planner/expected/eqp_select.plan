# xqt planner --record: per query, the SHA-256 (16 hex digits) of xqlite's
# EXPLAIN and of its EXPLAIN QUERY PLAN, then the query. "----" starts
# the next block of the case file.
51ac5c833d28e2e3 3919fafd4b054f18 SELECT * FROM t ORDER BY b
fd511e08f887d5e2 37dcce167b01e300 SELECT 1 UNION ALL SELECT 2
944ed4c54d270243 b93946085dafb602 SELECT a FROM t UNION SELECT b FROM t
a16e10726fdb0cfa 8f97783108ee4caa SELECT count(*) FROM t
5b43906f96494391 6571b6089fe5a508 SELECT (SELECT max(a) FROM t), b FROM t
468b11bfc694a474 8055440ed0c69f2a SELECT * FROM t WHERE a IN (SELECT b FROM t)
fa1f50c6f05434b3 946ea35fdd2f806c SELECT DISTINCT b FROM t
ce33a748ed24c93d b459d771be10eed2 SELECT b, count(*) FROM t GROUP BY b
2543e261d6066a27 0bb333a196f128ff WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c WHERE n<5) SELECT * FROM c
0bb1f8be406e80dc eac4de7544a1fda5 SELECT * FROM (SELECT a, b FROM t ORDER BY b LIMIT 3) ORDER BY a
4d25865daee8300f 107c3c7a960d02d0 VALUES(1),(2),(3)
b417d4d2ac355bc5 7655d02508036861 SELECT group_concat(DISTINCT a) FROM t
218571db16a71100 f2624c29b4eaaed5 SELECT * FROM t WHERE a = (SELECT b FROM t AS x WHERE x.a = t.b)
