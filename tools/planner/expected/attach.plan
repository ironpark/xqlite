409ddac6c69b013c ee2ef6c28296e764 SELECT t.b, w.v FROM t, aux2.w WHERE w.k = t.b ORDER BY t.a LIMIT 4
b1d17b05761ed160 2413e7ce9d46416e SELECT y, n FROM aux1.uv ORDER BY n DESC, y LIMIT 3
a40d0e22025bc632 bebe87e7b96c5b13 SELECT * FROM aux1.uv WHERE y = 'v1'
b4f8141015f6a246 e91edc3deaaae302 SELECT (SELECT count(*) FROM aux1.u WHERE u.y = t.b) FROM t WHERE a < 4
4d9e73eb4c763f48 f8b3a8117e48ffff SELECT a FROM t WHERE b IN (SELECT k FROM aux2.w) ORDER BY a
907328597852331f 15df5dfab29d34bc SELECT k FROM aux2.w WHERE k > 'v1'
