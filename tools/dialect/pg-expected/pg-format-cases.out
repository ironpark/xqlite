==== case 768c0d69585ee67c definitions of gcd, lcm and AT TIME ZONE
def|pretty
CHECK ((((x AT TIME ZONE 'UTC'::text) AT TIME ZONE 'EST'::text) > y))|CHECK (((x AT TIME ZONE 'UTC'::text) AT TIME ZONE 'EST'::text) > y)
CHECK ((((y + iv) AT TIME ZONE z) IS NOT NULL))|CHECK (((y + iv) AT TIME ZONE z) IS NOT NULL)
CHECK (((gcd(b, i) + 1) > 0))|CHECK ((gcd(b, i) + 1) > 0)
CHECK (((x AT TIME ZONE 'UTC'::text) IS NOT NULL))|CHECK ((x AT TIME ZONE 'UTC'::text) IS NOT NULL)
CHECK (((x AT TIME ZONE iv) < y))|CHECK ((x AT TIME ZONE iv) < y)
CHECK ((gcd(a, (0)::numeric) > (0)::numeric))|CHECK (gcd(a, 0::numeric) > 0::numeric)
CHECK ((gcd(a, (b)::numeric) > (0)::numeric))|CHECK (gcd(a, b::numeric) > 0::numeric)
CHECK ((gcd(l, (i)::bigint) > 0))|CHECK (gcd(l, i::bigint) > 0)
CHECK ((lcm(l, (2)::bigint) >= 0))|CHECK (lcm(l, 2::bigint) >= 0)
CHECK ((timezone('UTC'::text, y) IS NOT NULL))|CHECK (timezone('UTC'::text, y) IS NOT NULL)
CHECK ((timezone(z, x) IS NOT NULL))|CHECK (timezone(z, x) IS NOT NULL)
(11 rows)
def|pretty
 SELECT gcd(a, (0)::numeric) AS g1,
    gcd(b, 2) AS g2,
    timezone(z, x) AS t1,
    (x AT TIME ZONE 'UTC'::text) AS t2,
    (y AT TIME ZONE z) AS t3
   FROM g;| SELECT gcd(a, 0::numeric) AS g1,
    gcd(b, 2) AS g2,
    timezone(z, x) AS t1,
    (x AT TIME ZONE 'UTC'::text) AS t2,
    (y AT TIME ZONE z) AS t3
   FROM g;
