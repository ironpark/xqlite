def
CHECK (
CASE
    WHEN (n > 0) THEN x
    ELSE true
END)
CHECK (((true = ANY (ARRAY[true, false])) OR (true = x)))
CHECK ((x = ANY (ARRAY[true, false])))
(3 rows)
def
 SELECT (x = ANY (ARRAY[true, false])) AS i,
        CASE
            WHEN (n > 0) THEN x
            ELSE true
        END AS c,
        CASE x
            WHEN true THEN 1
            ELSE NULL::integer
        END AS w
   FROM b;
