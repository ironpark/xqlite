.{
    // The proleptic Gregorian calendar and PostgreSQL's interval (months,
    // days, microseconds) with its BLOB: the module `datetime`. The root
    // package (../../build.zig.zon) depends on it by path.
    .name = .datetime,
    .version = "0.0.0",
    .fingerprint = 0x93f3c6ca53a37c78, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
