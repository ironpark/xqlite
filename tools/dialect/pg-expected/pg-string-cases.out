==== case 2ab52ab7e90a4453 regular expressions in a table, a CHECK and a view
code|prefix|num|short
AB-12|AB|12|f
CD-3|CD|3|t
EF-456|EF|456|f
(3 rows)
def
 SELECT code,
    regexp_replace(code, '-.*'::text, ''::text) AS prefix,
    "substring"(code, '\d+'::text) AS num,
    (code ~ similar_to_escape('%-_'::text)) AS short
   FROM codes;
(1 row)
def
 SELECT (code ~* '^ab'::text) AS a,
    (code !~ 'x'::text) AS b,
    (code !~ similar_to_escape('A#_%'::text, '#'::text)) AS c,
    regexp_match(code, '(\d)'::text) AS d,
    regexp_count(code, '\d'::text, 1) AS e,
    regexp_like(code, 'b'::text, 'i'::text) AS g
   FROM codes;
(1 row)
