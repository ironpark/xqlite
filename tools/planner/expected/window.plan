21f06b888e3f7657 654a35b89ee9e968 DELETE FROM t1 WHERE a IN (SELECT a FROM (SELECT a, row_number() OVER (PARTITION BY b ORDER BY a) AS r FROM t1) WHERE r > 3)
2acda6994d629b61 abebfb8e60f6959e CREATE TABLE t9 AS SELECT a, ntile(3) OVER (ORDER BY a) AS q FROM t1 WHERE a < 10
