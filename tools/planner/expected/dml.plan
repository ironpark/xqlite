# xqt planner --record: per query, the SHA-256 (16 hex digits) of xqlite's
# EXPLAIN and of its EXPLAIN QUERY PLAN, then the query. "----" starts
# the next block of the case file.
d6fdd2abf68290db c524940a680e3c38 DELETE FROM t INDEXED BY tb WHERE b = 'x'
a4d927c57ae67f18 0e9574d5e2cced66 DELETE FROM t INDEXED BY tb WHERE d IS NULL
efc03507bc7c39f7 9dafb886aed987e6 UPDATE t INDEXED BY tb SET c = c + 1 WHERE b > 'a'
83d0a0da03444a3d 8f97783108ee4caa UPDATE t NOT INDEXED SET c = 0 WHERE b = 'y'
d7880e79a2ea56a6 d7880e79a2ea56a6 DELETE FROM t INDEXED BY nosuch WHERE b = 'x'
2157458e39ddb050 e3b0c44298fc1c14 INSERT INTO t(b,c) VALUES('x', 1) RETURNING *
dac85cd57e19dbe0 8f97783108ee4caa INSERT INTO t SELECT a+10, b, c, d FROM t RETURNING a, b || '!' AS bb, c * 2, rowid
b69e69812af0c915 19794aeedf41f550 UPDATE t SET c = c + 1 WHERE a > 1 RETURNING a, c, (SELECT count(*) FROM t) AS n
afcf5eb9aec3abf8 4413343efd51860f UPDATE t SET c = c + 1 WHERE b = 'x' RETURNING a, (SELECT count(*) FROM log)
716f93b8c20a4960 e6bd6691240d019a DELETE FROM t WHERE a = 1 RETURNING *, 'gone'
216765cdc4596735 8f97783108ee4caa DELETE FROM t RETURNING b
b82dc1bf0b1a5dd8 37469b3988088847 DELETE FROM w WHERE x = 1 RETURNING *
d8702852047930a6 f6852ad21275945b UPDATE w SET y = 5 RETURNING x, y
ff2926e2c5f533c1 e3b0c44298fc1c14 INSERT INTO w VALUES(3,4) RETURNING x+y
84417e69dbd3491b 4d8e81043e590997 UPDATE t SET d = (SELECT max(a) FROM t) RETURNING d, (SELECT b FROM t AS t2 WHERE t2.a = t.a)
